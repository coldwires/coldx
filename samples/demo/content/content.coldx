# The demo's content, packed into content.rime beside demo.exe by coldx_add_content
# (see CMakeLists.txt): encrypted with a key made in the build folder, fingerprinted with
# the build id, and the sheet watermarked in its alpha channel.
seed = coldx demo

[texture] sheet.png
watermark = alpha
[sound] *.wav
[data] credits.txt levels/*.wave

[music] loop.ogg
from = ../../hello_audio/content

# Silkscreen, a pixel font, travels with its license (SIL Open Font License).
[font] silkscreen/Silkscreen-Regular.ttf
from = ../../../third_party/fonts
[data] silkscreen/LICENSE
from = ../../../third_party/fonts
